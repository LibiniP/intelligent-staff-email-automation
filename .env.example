# Copy to .env and fill in. .env is gitignored: never commit it.

# --- Database ---
# Local quick start (no Postgres needed):
DATABASE_URL=sqlite:///./staff_email.db
# Postgres (matches docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://staff:staff@localhost:5432/staff_email

# --- Microsoft Graph (empty = mock mode, no real mail is sent) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Mailbox that sends the emails (shared mailbox recommended)
GRAPH_SENDER_MAILBOX=

# --- AI (empty = template-only drafts) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Auth ---
# 1 = dev header login (local only). Set 0 once Entra ID login is built.
AUTH_DEV=1
# Entra ID (for the future login)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
